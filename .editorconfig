# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Go files (for consistency with Go conventions)
[*.go]
indent_style = tab
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
