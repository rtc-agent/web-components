{
  "packages/component/**/*.{js,jsx,tsx,ts,css,less}": [
    "pnpm --filter @rtc-agent/component exec biome check --write"
  ],
  "packages/component/**/*.md": [
    "pnpm --filter @rtc-agent/component exec biome check --write"
  ],
  "*.{js,jsx,tsx,ts,css,less,json,md}": [
    "biome check --write"
  ]
}
