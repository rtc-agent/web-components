# =============================================================================
# pnpm Engine Strict Configuration
# =============================================================================
#
# Enforce engine requirements from package.json (node >=22.0.0, pnpm >=8.0.0).
# Prevents installation with incompatible Node.js or pnpm versions, which could
# cause build failures or runtime issues due to API incompatibilities.
#
# Reference: https://pnpm.io/npmrc#engine-strict
# =============================================================================
engine-strict=true

# =============================================================================
# pnpm Lifecycle Scripts Configuration
# =============================================================================
#
# pnpm v8 默认不运行 pre*/post* 生命周期钩子（v9+ 才默认启用）。
# 显式打开，让 component 的 prebuild / pretypecheck / pretest / predev
# 能在 `pnpm build` 等命令前自动跑 `lit-localize build` 生成 i18n 产物，
# 避免 CI 上因 `.generated/` 缺失导致构建失败。
#
# 影响范围：
# - component: prebuild/pretypecheck/pretest/predev → lit-localize build
# - 其他包的 pre*/post* 脚本（如果有的话）
#
# 参考：https://pnpm.io/npmrc#enable-pre-post-scripts
# =============================================================================
enable-pre-post-scripts=true
