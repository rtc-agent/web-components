{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/.umi",
      "!**/.umi-production",
      "!**/.umi-test",
      "!**/.umi-test-production",
      "!**/src/services",
      "!**/mock",
      "!**/server",
      "!**/public",
      "!**/.worktrees",
      "!package-lock.json",
      "!pnpm-lock.yaml",
      "!tailwind.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off", // TODO: Gradual migration strategy — this rule is temporarily disabled to allow incremental type improvements. Target: enable by end of 2026.
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useExhaustiveDependencies": "off"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/admin-ui/**"],
      "javascript": {
        "jsxRuntime": "reactClassic"
      }
    }
  ]
}
