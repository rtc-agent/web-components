{
  "name": "rtc-agent-component",
  "version": "0.1.0",
  "private": true,
  "description": "RTC Agent Web Component monorepo",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter @rtc-agent/component",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "sync-version": "node scripts/sync-version.js",
    "verify-version": "node scripts/verify-version-alignment.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.5.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "vitest": "^2.1.9",
      "@vitest/coverage-v8": "^2.1.9",
      "@vitest/ui": "^2.1.9",
      "typescript": "5.9.3"
    }
  }
}
