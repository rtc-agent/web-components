{
  "name": "@rtc-agent/client",
  "version": "0.3.0-rc.2",
  "description": "RTC Agent 通信层：Centrifuge 连接、RPC 调用、实时订阅、流式消息",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "import": "./dist/test-utils/index.js",
      "default": "./dist/test-utils/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node ../../scripts/remove-sourcemap-refs.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-storage": "^3.658.0",
    "@rtc-agent/protocol": "workspace:*",
    "centrifuge": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9"
  }
}
