{
  "name": "@rtc-agent/component",
  "version": "0.3.0-rc.2",
  "description": "RTC Agent Web Components（基于 Lit）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rtc-agent-setup": "./bin/rtc-agent-setup.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "lit-localize build && rm -rf dist && vite build && tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "vite",
    "predev": "lit-localize build",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "lit-localize build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "pretest": "lit-localize build",
    "test:e2e": "playwright test",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "i18n:validate-xliff": "tsx scripts/check-xliff-quality.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@primer/octicons": "^19.33.0",
    "@rtc-agent/client": "workspace:*",
    "@rtc-agent/persistence": "workspace:*",
    "@rtc-agent/protocol": "workspace:*",
    "@rtc-agent/worker": "workspace:*",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "interactjs": "^1.10.28",
    "lit": "^3.1.0",
    "marked": "^18.0.11",
    "spark-md5": "^3.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.2.0",
    "@types/spark-md5": "^3.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.9"
  }
}
