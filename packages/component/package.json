{
  "name": "@rtc-agent/component",
  "version": "0.1.0",
  "description": "RTC Agent Web Components（基于 Lit）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prebuild": "lit-localize build",
    "dev": "vite",
    "predev": "lit-localize build",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "lit-localize build",
    "test": "vitest run --passWithNoTests",
    "pretest": "lit-localize build",
    "i18n:extract": "lit-localize extract",
    "i18n:build": "lit-localize build",
    "i18n:lint": "lit-localize lint"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit-labs/virtualizer": "^2.1.1",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@primer/octicons": "^19.33.0",
    "@rtc-agent/client": "workspace:*",
    "@rtc-agent/persistence": "workspace:*",
    "@rtc-agent/protocol": "workspace:*",
    "@rtc-agent/worker": "workspace:*",
    "comlink": "^4.4.2",
    "dompurify": "^3.4.14",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "interactjs": "^1.10.28",
    "lit": "^3.1.0",
    "marked": "^18.0.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@types/dompurify": "^3.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.0.0"
  }
}
