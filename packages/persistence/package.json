{
  "name": "@rtc-agent/persistence",
  "version": "0.3.0-rc.2",
  "description": "RTC Agent 本地持久化层：IndexedDB + Dexie.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/remove-sourcemap-refs.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "biome lint src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@rtc-agent/client": "workspace:*",
    "@rtc-agent/protocol": "workspace:*",
    "dexie": "^4.4.5",
    "microdiff": "^1.6.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/spark-md5": "^3.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.0.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
