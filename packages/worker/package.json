{
  "name": "@rtc-agent/worker",
  "version": "0.1.0",
  "description": "RTC Agent SharedWorker：多 Tab 共享一条 WebSocket + 一个 IndexedDB",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shared-worker": {
      "types": "./dist/shared-worker.d.ts",
      "import": "./dist/shared-worker.js",
      "default": "./dist/shared-worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/"
  },
  "dependencies": {
    "@rtc-agent/client": "workspace:*",
    "@rtc-agent/persistence": "workspace:*",
    "@rtc-agent/protocol": "workspace:*",
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^30.0.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
