#!/usr/bin/env bash
#
# Pre-commit hook for rtc-agent/web-components
# - API key leak detection (OpenAI / Claude)
# - Large file detection (> 5MB)
# - Executable file detection (no extension / .exe)
# - TypeScript type check

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0

# Get staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# ============================================================
# 1. API Key Leak Detection
# ============================================================
echo "🔍 Checking for API key leaks..."

declare -a PATTERNS=(
    'sk-proj-[A-Za-z0-9_-]{20,}'
    'sk-[A-Za-z0-9]{32,}'
    'sk-ant-[A-Za-z0-9_-]{20,}'
    'ANTHROPIC_API_KEY\s*=\s*["\x27][^"\x27]+'
    'OPENAI_API_KEY\s*=\s*["\x27][^"\x27]+'
    'xoxb-[0-9A-Za-z-]+'
)

API_KEY_FOUND=0
while IFS= read -r file; do
    if ! git diff --cached --name-only --diff-filter=d -- "$file" | grep -qE '\.(ts|tsx|js|jsx|md|yaml|yml|json|env|conf|cfg)$'; then
        continue
    fi
    for pattern in "${PATTERNS[@]}"; do
        if git show ":$file" | grep -qEi "$pattern" 2>/dev/null; then
            echo -e "${RED}  ✗ Potential API key found in: $file${NC}"
            API_KEY_FOUND=1
        fi
    done
done <<< "$STAGED_FILES"

if [ "$API_KEY_FOUND" -eq 1 ]; then
    echo -e "${RED}✗ API key leak detected! Remove keys before committing.${NC}"
    ERRORS=1
else
    echo -e "${GREEN}  ✓ No API key leaks found${NC}"
fi

# ============================================================
# 2. Large File Detection (> 5MB)
# ============================================================
echo "🔍 Checking for large files (> 5MB)..."

MAX_SIZE=$((5 * 1024 * 1024))
LARGE_FILE_FOUND=0

while IFS= read -r file; do
    if [ ! -f "$file" ]; then
        continue
    fi
    file_size=$(wc -c < "$file" | tr -d ' ')
    if [ "$file_size" -gt "$MAX_SIZE" ]; then
        size_mb=$(awk "BEGIN {printf \"%.2f\", $file_size/1024/1024}")
        echo -e "${RED}  ✗ Large file: $file (${size_mb} MB)${NC}"
        LARGE_FILE_FOUND=1
    fi
done <<< "$STAGED_FILES"

if [ "$LARGE_FILE_FOUND" -eq 1 ]; then
    echo -e "${RED}✗ Files exceeding 5MB detected!${NC}"
    ERRORS=1
else
    echo -e "${GREEN}  ✓ No large files found${NC}"
fi

# ============================================================
# 3. Executable File Detection (no extension / .exe)
# ============================================================
echo "🔍 Checking for executable files..."

EXEC_FOUND=0

while IFS= read -r file; do
    basename=$(basename "$file")
    # Skip the hook scripts themselves
    if [[ "$file" == "scripts/pre-commit" ]] || [[ "$file" == "scripts/pre-push" ]]; then
        continue
    fi
    if [[ "$basename" != *.* ]] || [[ "$basename" == *.exe ]]; then
        echo -e "${RED}  ✗ Executable detected: $file${NC}"
        EXEC_FOUND=1
    fi
done <<< "$STAGED_FILES"

if [ "$EXEC_FOUND" -eq 1 ]; then
    echo -e "${RED}✗ Executable files should not be committed!${NC}"
    ERRORS=1
else
    echo -e "${GREEN}  ✓ No executable files found${NC}"
fi

# ============================================================
# 4. TypeScript type check
# ============================================================
echo "🔍 Running TypeScript type check..."

if ! command -v pnpm &> /dev/null; then
    echo -e "${YELLOW}  ⚠ pnpm not installed, skipping type check${NC}"
else
    TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$' || true)

    if [ -n "$TS_FILES" ]; then
        if pnpm typecheck; then
            echo -e "${GREEN}  ✓ TypeScript type check passed${NC}"
        else
            echo -e "${RED}✗ TypeScript type check failed!${NC}"
            ERRORS=1
        fi
    else
        echo -e "${GREEN}  ✓ No .ts/.tsx files changed, skipping type check${NC}"
    fi
fi

# ============================================================
# Final result
# ============================================================
echo ""
if [ "$ERRORS" -eq 1 ]; then
    echo -e "${RED}❌ Pre-commit checks failed. Commit aborted.${NC}"
    exit 1
else
    echo -e "${GREEN}✅ All pre-commit checks passed.${NC}"
    exit 0
fi
