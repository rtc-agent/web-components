{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    ".npmrc",
    "biome.json",
    "vitest.base.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "public/**",
        "config/**",
        "mock/**",
        "tsconfig.json",
        "package.json",
        "vite.config.ts",
        "tsup.config.ts",
        "tailwind.config.*",
        "tailwind.css",
        "lit-localize.json",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/*.integration.test.ts",
        "!src/**/test-setup.ts",
        "!src/**/test-utils/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "vite.config.ts",
        "tsup.config.ts",
        "vitest.config.ts",
        "vitest.integration.config.ts",
        "lit-localize.json"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "vitest.config.ts",
        "vitest.integration.config.ts",
        "vite.config.ts",
        "tsup.config.ts",
        "lit-localize.json"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "vitest.config.ts",
        "vitest.integration.config.ts",
        "vite.config.ts",
        "tsup.config.ts",
        "lit-localize.json"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", "tsconfig.json"]
    },
    "lint:fix": {
      "inputs": ["src/**", "tsconfig.json"]
    },
    "format": {
      "inputs": ["src/**"]
    }
  }
}
